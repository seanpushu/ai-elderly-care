modules = ["python-3.11"]
run = "python -m venv .venv && .venv/bin/python -m pip install --no-user -r requirements.txt && .venv/bin/python start.py"

[deployment]
build = ["sh", "-c", "python -m venv .venv && .venv/bin/python -m pip install --no-user -r requirements.txt"]
run = ["sh", "-c", ".venv/bin/python start.py"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8000
externalPort = 80
[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m venv .venv && .venv/bin/python -m pip install --no-user -r requirements.txt && PORT=5000 .venv/bin/python start.py"
waitForPort = 5000
